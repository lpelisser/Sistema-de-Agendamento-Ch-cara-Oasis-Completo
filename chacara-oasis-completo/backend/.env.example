# Banco de dados. Por padrão usa SQLite local (bom para testar na sua máquina).
DATABASE_URL=sqlite:///./chacara_oasis.db

# Para produção (ex: hospedar no Render), use um Postgres gratuito do Neon
# (neon.tech). Cole aqui a "Connection string" que o Neon te dá, no formato:
# DATABASE_URL=postgresql://usuario:senha@ep-xxxxx.neon.tech/nome_do_banco?sslmode=require

# Configuração de e-mail (opcional). Sem essas 3 variáveis preenchidas,
# a reserva é criada normalmente e apenas o e-mail de notificação ao ADM não é enviado.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ADMIN_EMAIL=
